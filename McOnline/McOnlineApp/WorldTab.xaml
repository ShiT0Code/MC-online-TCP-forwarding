<?xml version="1.0" encoding="utf-8"?>
<TabViewItem
    x:Class="McOnlineApp.WorldTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:McOnlineApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    CloseRequested="TabViewItem_CloseRequested"
    Loaded="TabViewItem_Loaded">
    <TabViewItem.IconSource>
        <FontIconSource Glyph="&#xE909;"/>
    </TabViewItem.IconSource>
    <FlyoutBase.AttachedFlyout>
        <Flyout x:Name="exitFlyout">
            <StackPanel Spacing="8">
                <TextBlock Text="关闭标签页将关闭此联机！🫨"/>
                <Button Content="确定" Click="Close_Button_Click"/>
            </StackPanel>
        </Flyout>
    </FlyoutBase.AttachedFlyout>

    <ScrollView>
        <Grid RowSpacing="24" Padding="24" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCritical}" x:Name="errorIcon" FontSize="20" Visibility="Collapsed"/>
            <InfoBar x:Name="infoBar" IsOpen="False" Grid.ColumnSpan="2"/>
            <TextBlock Text="进度" FontWeight="Bold" FontSize="20" Grid.Row="1"/>

            <ProgressRing x:Name="ring1" Grid.Row="2" Width="24" Height="24" IsActive="False"/>
            <FontIcon Glyph="&#xE712;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" x:Name="statusIcon1" Grid.Row="2" FontSize="20"/>
            <TextBlock Text="连接到服务器" Grid.Column="1" Grid.Row="2" FontSize="16" VerticalAlignment="Center"/>

            <ProgressRing x:Name="ring2" Grid.Row="3" IsActive="False" Width="24" Height="24"/>
            <FontIcon Glyph="&#xE712;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" x:Name="statusIcon2" Grid.Row="3" FontSize="20"/>
            <TextBlock Text="等待对方游戏连接" Grid.Column="1" Grid.Row="3" FontSize="16" VerticalAlignment="Center"/>
            
            <ctc:SettingsCard Header="操作" Grid.Row="4" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="取消" Click="Cancel_Button_Click" x:Name="cancelBu" IsEnabled="False"/>
                    <Button Style="{ThemeResource AccentButtonStyle}" Content="重试" Click="RetryButton_Click" x:Name="retryBu"/>
                </StackPanel>
            </ctc:SettingsCard>
        </Grid>
    </ScrollView>
</TabViewItem>
