<?xml version="1.0" encoding="utf-8"?>
<TabViewItem
    x:Class="McOnlineApp.UserGuideTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:McOnlineApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Header="食用教程">
    <TabViewItem.IconSource>
        <FontIconSource Glyph="&#xE897;" />
    </TabViewItem.IconSource>
    <ScrollView>
        <StackPanel Spacing="16" Padding="24">
            <TextBlock FontSize="24" FontWeight="Bold" Text="食用教程" />

            <StackPanel Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock FontSize="18" FontWeight="Bold" Text="各选项的解释" Margin="0 0 0 8"/>
                <StackPanel Spacing="12" Padding="16">
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>联机角色：</Bold>创建房间供他人加入请选「我负责打开存档」（房主）；加入别人的房间请选「我要连接到联机游戏」（玩家）
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>服务器：</Bold>填写联机中转服务器的地址，支持IP或域名，按运营方/房主提供的内容填写即可
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>服务器端口：</Bold>服务器的连接端口号，与服务器地址配套使用，请按运营方/房主提供的数值填写
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>标签页显示名称：</Bold>设置本联机标签的标题，方便区分多个房间。加入模式下，该名称还会显示在游戏的局域网游戏列表中
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>本地端口：</Bold>
                            <LineBreak/>
                            房主模式：必须与游戏内「对局域网开放」的端口号完全一致
                            <LineBreak/>
                            加入模式：游戏通过该端口连接工具，默认即可，连接冲突时可自行修改
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16">
                        <Bold>自动重连：</Bold>联机成功后若意外断开，将在3秒后自动尝试重新连接
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <TextBlock FontSize="20" FontWeight="Bold" Text="操作流程"/>
            <StackPanel Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock Text="房主模式" FontSize="18" FontWeight="Bold"/>
                <StackPanel Spacing="12" Padding="16">
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16" Text="&#0160;1. 进入要联机的存档，按 ESC 呼出游戏菜单，点击「世界选项」&#x0a;
2. 找到“多人游戏”栏，开启「局域网」开关，记下右侧的端口号&#x0a;
3. 切回本工具，将游戏内的端口号填入「本地端口」&#x0a;
4. 依次填写服务器地址、服务器端口，标签页名称可保留默认&#x0a;
5. 按需开启自动重连，最后点击「开始联机」即可"/>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="⚠️ 注意：设置完这里，一定要点击「应用更改」，否则不生效！"/>
                    <Grid CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1">
                        <Image Source="/Assets/Images/Menuscreen_26.3_Simplified.png" ToolTipService.ToolTip="Minecraft 26.3 的游戏菜单" AutomationProperties.Name="Minecraft 26.3 的游戏菜单"
                                MaxWidth="480" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1">
                        <Image Source="/Assets/Images/WorldOption.png" ToolTipService.ToolTip="Minecraft 26.3 的世界选项" AutomationProperties.Name="Minecraft 26.3 的世界选项"
                                MaxWidth="853" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock Text="玩家模式：" FontSize="18" FontWeight="Bold"/>
                <StackPanel Spacing="12" Padding="16">
                    <TextBlock TextWrapping="WrapWholeWords" FontSize="16"  Text="&#0160;1. 填写房主提供的服务器地址与服务器端口&#x0a;
2. 本地端口推荐使用默认值，连接失败可更换端口重试&#x0a;
3. 自定义标签页名称，按需开启自动重连&#x0a;
4. 点击「开始联机」启动联机通道&#x0a;
5. 打开MC进入「多人游戏」，在局域网列表找到对应房间&#x0a;
6. 选中房间后点击「加入服务器」，即可进入游戏"/>
                    <Grid CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1">
                        <Image Source="/Assets/Images/Multiplayer_Screen_Simplified.png" ToolTipService.ToolTip="Minecraft 的多人游戏菜单" AutomationProperties.Name="Minecraft 的多人游戏菜单"
                                        MaxWidth="852" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <TextBlock FontSize="20" FontWeight="Bold" Text="连接失败/重试无效怎么办？" Margin="0 0 0 8"/>
            <StackPanel Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="16">
                <TextBlock FontSize="18" Text="按以下顺序逐层排查：" FontWeight="Bold"/>
                <TextBlock FontSize="15" TextWrapping="WrapWholeWords" Padding="16" Text="&#0160;1. 先点击重试，多数情况是临时网络波动&#x0a;
2. 关闭当前联机标签页，核对：服务器地址/端口是否正确、有无多余空格，电脑网络是否正常&#x0a;
3. 房主额外检查：游戏内局域网是否已开启、端口号与工具是否一致&#x0a;
4. 加入方额外检查：更换一个本地端口后重新尝试&#x0a;
5. 以上均无效，重启工具与游戏后再试"/>
            </StackPanel>

            <TextBlock Text="祝你游玩愉快！😊🎉" FontSize="24" FontWeight="Bold" Margin="0 12 0 12"/>
        </StackPanel>
    </ScrollView>
</TabViewItem>
